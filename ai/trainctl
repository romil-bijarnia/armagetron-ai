#!/bin/sh
# trainctl: start, stop and watch Armagetron AI training from any terminal.
#
#   ./trainctl start [flags]    train with the teacher (self-play with search in the simulator, a league
#                               of past selves and an exploiter) in the background, Mac kept awake, and
#                               open the brain page; restarts itself from the last checkpoint if it crashes
#   ./trainctl gentle [flags]   same, but fewer rounds at once and at low priority so the laptop stays usable
#   ./trainctl ppo [flags]      the old trainer instead (PPO against the real engine), in runs/ppo
#   ./trainctl ladder [flags]   rate the network in the real game: duels against the built-in AI, the old
#                               brain and the league pool, fitted into Elo ratings (runs/v2/ratings.json)
#   ./trainctl stop             stop training (it saves a checkpoint on the way out)
#   ./trainctl status           is it running, latest progress, when the last checkpoint was saved
#   ./trainctl watch            terminal charts of how training is going (Ctrl-C closes them, not training)
#   ./trainctl show [flags]     watch the AI play a match, drawn in the terminal (Ctrl-C quits)
#   ./trainctl brain [flags]    watch the network think: every neuron live in the browser, with pause
#                               and single-step; follows the newest weights while training runs
#   ./trainctl log              follow the training log (Ctrl-C stops watching, not training)
#
# Extra flags go straight to the trainer, e.g. ./trainctl start --lr 1e-4 or --run runs/exp1.
# Checkpoints are saved automatically every few minutes and whenever training stops.

set -u
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$self")" || exit 1

cmd="${1:-help}"
[ $# -gt 0 ] && shift

# the run folder is the value after --run: runs/v2 by default, runs/ppo for the old trainer
run=runs/v2
[ "$cmd" = ppo ] && run=runs/ppo
prev=""
for a in "$@"; do
    [ "$prev" = "--run" ] && run="$a"
    prev="$a"
done
mkdir -p "$run"
pidfile="$run/trainctl.pid"
stopflag="$run/trainctl.stop"
log="$run/train.log"

short="$(printf '%s' "$self" | sed "s|^$HOME|~|")"  # how to call this script, for messages

running() { [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; }
dashboard() { exec uv run -q arma-dash --run "$run"; }
brainpage() {
    # the brain page follows runs/<run>/actor.pt, which exists after the first update: wait for it
    # in the background, then start the page (it opens the browser itself); the brain log is beside train.log
    pkill -f "bin/arma-brain" 2>/dev/null
    nohup sh -c 'i=0; while [ ! -f "'"$run"'/actor.pt" ] && [ $i -lt 600 ]; do sleep 1; i=$((i+1)); done; exec uv run -q arma-brain --checkpoint "'"$run"'/actor.pt"' >> "$run/brain.log" 2>&1 &
}
trainer_pids() { pgrep -f "bin/arma-(train|teach)"; }
stamp() { date '+%Y-%m-%d %H:%M:%S'; }

case "$cmd" in
start | gentle | ppo)
    if running; then
        echo "already training in $run"
        pgrep -f "bin/arma-brain" >/dev/null || brainpage
        exit 0
    fi
    if [ -n "$(trainer_pids)" ]; then
        echo "a training process started some other way is already running; stop it first (pkill -f arma-teach)"
        exit 1
    fi
    command -v uv >/dev/null || { echo "uv not found on PATH"; exit 1; }
    rm -f "$stopflag"
    if [ "$cmd" = ppo ]; then
        [ "$run" = runs/ppo ] && set -- --run runs/ppo "$@"
        nohup caffeinate -i "$self" _supervise train "$@" >> "$log" 2>&1 &
    elif [ "$cmd" = gentle ]; then
        set -- --games 96 --threads 4 "$@"
        nohup nice -n 15 "$self" _supervise teach "$@" >> "$log" 2>&1 &
    else
        nohup caffeinate -i "$self" _supervise teach "$@" >> "$log" 2>&1 &
    fi
    echo $! > "$pidfile"
    echo "training started ($cmd) in $run"
    mkdir -p "$run"
    brainpage
    echo "the brain page opens in your browser once the first update has landed (a minute or two)"
    echo "stop it:  $short stop"
    ;;

_supervise)
    trainer="$1"  # teach or train
    shift
    quick=0
    first=1
    while :; do
        started=$(date +%s)
        if [ "$first" = 1 ]; then
            uv run "arma-$trainer" "$@"
        else
            uv run "arma-$trainer" "$@" --resume true  # a restart always continues from the checkpoint
        fi
        code=$?
        first=0
        # engines of a crashed trainer exit on their own; make sure none linger before restarting
        pkill -f "/runtime/$(basename "$run")/engine" 2>/dev/null
        [ -f "$stopflag" ] && break
        [ "$code" -eq 0 ] && break
        if [ $(( $(date +%s) - started )) -lt 120 ]; then quick=$((quick + 1)); else quick=0; fi
        if [ "$quick" -ge 3 ]; then
            echo "$(stamp) trainctl: training failed three times right after starting, giving up (see the errors above)"
            break
        fi
        echo "$(stamp) trainctl: training exited with code $code, restarting from the last checkpoint in 15 s"
        sleep 15
    done
    rm -f "$pidfile" "$stopflag"
    ;;

stop)
    if ! running && [ -z "$(trainer_pids)" ]; then
        echo "not training"
        pkill -f "bin/arma-brain" 2>/dev/null
        pkill -f "/runtime/$(basename "$run")/engine" 2>/dev/null
        rm -f "$pidfile" "$stopflag"
        exit 0
    fi
    touch "$stopflag"
    pkill -f "bin/arma-brain" 2>/dev/null
    pids=$(trainer_pids)
    [ -n "$pids" ] && kill -TERM $pids
    echo "stopping and saving a checkpoint..."
    i=0
    while { running || [ -n "$(trainer_pids)" ]; } && [ $i -lt 120 ]; do
        sleep 1
        i=$((i + 1))
    done
    if running || [ -n "$(trainer_pids)" ]; then
        echo "still shutting down after 2 minutes; check again with ./trainctl status"
    else
        pkill -f "/runtime/$(basename "$run")/engine" 2>/dev/null
        rm -f "$pidfile" "$stopflag"
        echo "stopped; checkpoint saved in $run/latest.pt"
    fi
    ;;

status)
    if running; then
        echo "training (pid $(cat "$pidfile")), run folder $run"
    elif [ -n "$(trainer_pids)" ]; then
        echo "training (started without trainctl)"
    else
        echo "not training"
    fi
    [ -f "$log" ] && grep '^u[0-9]' "$log" | tail -1
    [ -f "$run/latest.pt" ] && echo "last checkpoint saved $(date -r "$run/latest.pt" '+%Y-%m-%d %H:%M:%S')"
    ;;

watch)
    dashboard
    ;;

show)
    exec uv run -q arma-show "$@"
    ;;

brain)
    exec uv run -q arma-brain "$@"
    ;;

ladder)
    exec uv run -q arma-ladder "$@"
    ;;

log)
    touch "$log"
    tail -n 20 -f "$log"
    ;;

*)
    sed -n '2,21p' "$self" | sed 's/^# \{0,1\}//'
    ;;
esac
