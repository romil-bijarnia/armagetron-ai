#!/bin/sh
# trainctl: start, stop and watch Armagetron AI training from any terminal.
#
#   ./trainctl bots [flags]        native bot RL; --mode background (default) or full
#   ./trainctl background [flags]  96 parallel arenas, 4 simulation workers, batch 256, low priority;
#                                  actor and learner each rest to target 35% work / total time
#   ./trainctl full [flags]        256 parallel arenas, simulation workers for all CPU cores, batch 512;
#                                  no work/rest cap;
#                                  Mac kept awake; uses the GPU for batched inference and learning
#   ./trainctl gentle [flags]      alias for background
#   ./trainctl start [flags]       alias for full
#                                  terminal progress opens when attached; --no-watch detaches
#   ./trainctl imitate [flags]     continuous foreground imitation; --epochs N limits this session
#   ./trainctl ladder [flags]   rate V4 in the real game against the built-in AI and the league pool,
#                               fitted into Elo ratings (runs/blacklight/ratings.json)
#   ./trainctl stop             stop training (it saves a checkpoint on the way out)
#   ./trainctl status           is it running, latest progress, when the last checkpoint was saved
#   ./trainctl watch            reconnect to the compact training console (Ctrl-C closes it, not training)
#   ./trainctl dashboard        optional full-screen terminal charts
#   ./trainctl show [flags]     watch the AI play a match, drawn in the terminal (Ctrl-C quits)
#   ./trainctl brain [flags]    live training game, bot inputs, network structure and learning statistics
#                               no replay or speed controls; viewer starts only when requested
#   ./trainctl log              follow the training log (Ctrl-C stops watching, not training)
#
# Extra flags go to the trainer, except --no-watch, e.g. ./trainctl start --lr 1e-4 or --run runs/exp1.
# Checkpoints are saved automatically every few minutes and whenever training stops.

set -u
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$self")" || exit 1

cmd="${1:-help}"
[ $# -gt 0 ] && shift

watch=auto
case "$cmd" in
background | full | start | gentle | bots)
    # Remove only our own option while preserving each trainer argument and its quoting.
    remaining=$#
    while [ "$remaining" -gt 0 ]; do
        arg=$1
        shift
        remaining=$((remaining - 1))
        case "$arg" in
            --no-watch) watch=off ;;
            *) set -- "$@" "$arg" ;;
        esac
    done
    ;;
esac

# the run folder is the value after --run: runs/blacklight by default
run=runs/blacklight
prev=""
for a in "$@"; do
    [ "$prev" = "--run" ] && run="$a"
    case "$a" in --run=*) run="${a#--run=}" ;; esac
    prev="$a"
done
if [ "$cmd" = bots ]; then
    for arg in "$@"; do
        case "$arg" in
            --help | -h) exec uv run -q python -m arma_ai.native_train --help ;;
        esac
    done
fi
mkdir -p "$run"
pidfile="$run/trainctl.pid"
imitation_pidfile="$run/imitation.pid"
stopflag="$run/trainctl.stop"
log="$run/train.log"

running() { [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; }
dashboard() { exec uv run -q arma-dash --run "$run" "$@"; }
progress() { exec uv run -q arma-dash --simple --run "$run" "$@"; }
watch_if_terminal() {
    if [ "$watch" = auto ] && [ -t 0 ] && [ -t 1 ]; then
        progress
    fi
}
imitation_pid() {
    [ -f "$imitation_pidfile" ] || return 1
    imitation=$(cat "$imitation_pidfile")
    case "$imitation" in '' | 0 | *[!0-9]*) return 1 ;; esac
    kill -0 "$imitation" 2>/dev/null || return 1
    # A stale PID file must never make stop signal an unrelated reused PID.
    imitation_command=$(ps -p "$imitation" -o command= 2>/dev/null)
    case " $imitation_command " in
        *'/arma-imitate '* | *' arma-imitate '* | *'/imitate '* | *' imitate '* | *' -m arma_ai.imitate '*)
            echo "$imitation" ;;
        *) return 1 ;;
    esac
}
trainer_pids() { { pgrep -f 'bin/arma-teach|[[:space:]]-m[[:space:]]+arma_ai\.(teach|native_train)([[:space:]]|$)'; imitation_pid; } | sort -nu; }
imitation_progress() {
    [ -f "$run/progress.json" ] && grep -q '"trainer"[[:space:]]*:[[:space:]]*"imitate"' "$run/progress.json"
}
stamp() { date '+%Y-%m-%d %H:%M:%S'; }

case "$cmd" in
background | full | start | gentle | bots)
    if running; then
        echo "already training in $run"
        watch_if_terminal
        exit 0
    fi
    if [ -n "$(trainer_pids)" ]; then
        echo "a training process started some other way is already running; save and stop it with stop"
        exit 1
    fi
    command -v uv >/dev/null || { echo "uv not found on PATH"; exit 1; }
    rm -f "$stopflag"
    mode=full
    case "$cmd" in background | gentle | bots) mode=background ;; esac
    prev=""
    for a in "$@"; do
        [ "$prev" = "--mode" ] && mode="$a"
        case "$a" in --mode=*) mode="${a#--mode=}" ;; esac
        prev="$a"
    done
    case "$mode" in
        background | full) ;;
        *) echo "--mode must be background or full"; exit 1 ;;
    esac
    # The Python parser supplies the preset; arguments after it override every default.
    set -- --mode "$mode" "$@"
    supervise=_supervise
    [ "$cmd" = bots ] && supervise=_supervise_bots
    if [ "$cmd" = bots ]; then
        # A separate session survives terminals and command runners that clean up
        # the invoking process group. Arguments remain literal, including run paths.
        python3 - "$self" "$supervise" "$mode" "$log" "$pidfile" "$@" <<'PY' || exit $?
import subprocess
import sys
from pathlib import Path

script, supervise, mode, log, pidfile, *arguments = sys.argv[1:]
command = [script, supervise, *arguments]
command = (["nice", "-n", "15"] if mode == "background" else ["caffeinate", "-i"]) + command
with open(log, "ab", buffering=0) as output:
    process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=output,
                               stderr=subprocess.STDOUT, start_new_session=True)
Path(pidfile).write_text(str(process.pid) + "\n")
PY
    elif [ "$mode" = background ]; then
        nohup nice -n 15 "$self" "$supervise" "$@" </dev/null >> "$log" 2>&1 &
        echo $! > "$pidfile"
    else
        nohup caffeinate -i "$self" "$supervise" "$@" </dev/null >> "$log" 2>&1 &
        echo $! > "$pidfile"
    fi
    echo "training started (${mode:-$cmd}) in $run"
    if [ "$cmd" = bots ]; then
        echo "native scripted bots only; watch progress with: ./blacklight watch"
    else
        echo "optional viewer:  brain --no-open --checkpoint \"$run/latest.pt\""
    fi
    echo "stop it:  stop --run \"$run\""
    watch_if_terminal
    ;;

imitate)
    if running || [ -n "$(trainer_pids)" ]; then
        echo "already training in $run; stop saves the current session"
        exit 1
    fi
    command -v uv >/dev/null || { echo "uv not found on PATH"; exit 1; }
    exec uv run -q arma-imitate "$@"
    ;;

_supervise | _supervise_bots)
    quick=0
    first=1
    while :; do
        started=$(date +%s)
        if [ "$cmd" = _supervise_bots ]; then
            uv run python -m arma_ai.native_train "$@"
        elif [ "$first" = 1 ]; then
            uv run arma-teach "$@"
        else
            uv run arma-teach "$@" --resume true  # a restart always continues from the checkpoint
        fi
        code=$?
        first=0
        [ -f "$stopflag" ] && break
        [ "$code" -eq 0 ] && break
        if [ $(( $(date +%s) - started )) -lt 120 ]; then quick=$((quick + 1)); else quick=0; fi
        if [ "$quick" -ge 3 ]; then
            echo "$(stamp) trainctl: training failed three times right after starting, giving up (see the errors above)"
            break
        fi
        echo "$(stamp) trainctl: training exited with code $code, restarting from the last checkpoint in 15 s"
        sleep 15
    done
    rm -f "$pidfile" "$stopflag"
    ;;

stop)
    if ! running && [ -z "$(trainer_pids)" ]; then
        echo "not training"
        rm -f "$pidfile" "$imitation_pidfile" "$stopflag"
        exit 0
    fi
    touch "$stopflag"
    pids=$(trainer_pids)
    [ -n "$pids" ] && kill -TERM $pids
    echo "stopping and saving a checkpoint..."
    i=0
    while { running || [ -n "$(trainer_pids)" ]; } && [ $i -lt 120 ]; do
        sleep 1
        i=$((i + 1))
    done
    if running || [ -n "$(trainer_pids)" ]; then
        echo "still shutting down after 2 minutes; check again with status"
    else
        rm -f "$pidfile" "$imitation_pidfile" "$stopflag"
        echo "stopped; checkpoint saved in $run/latest.pt"
    fi
    ;;

status)
    imitation=$(imitation_pid || true)
    if [ -n "$imitation" ]; then
        echo "imitation (pid $imitation), run folder $run"
    elif running; then
        echo "training (pid $(cat "$pidfile")), run folder $run"
    elif [ -n "$(trainer_pids)" ]; then
        echo "training (started without trainctl)"
    else
        echo "not training"
    fi
    if [ -n "$imitation" ] || imitation_progress || { [ -f "$run/progress.json" ] && grep -q '"trainer"[[:space:]]*:[[:space:]]*"native_rl"' "$run/progress.json"; }; then
        progress --once
    fi
    [ -f "$log" ] && grep '^u[0-9]' "$log" | tail -1
    [ -f "$run/latest.pt" ] && echo "last checkpoint saved $(date -r "$run/latest.pt" '+%Y-%m-%d %H:%M:%S')"
    ;;

watch)
    progress "$@"
    ;;

dashboard)
    dashboard "$@"
    ;;

show)
    exec uv run -q arma-show "$@"
    ;;

brain)
    exec uv run -q arma-brain "$@"
    ;;

ladder)
    exec uv run -q arma-ladder "$@"
    ;;

log)
    touch "$log"
    tail -n 20 -f "$log"
    ;;

*)
    sed -n '2,/^$/p' "$self" | sed 's/^# \{0,1\}//'
    ;;
esac
